# Database (Neon PostgreSQL in production, Docker PostgreSQL locally)
# Production (Neon): use the pooled connection URL for DATABASE_URL, direct URL for DIRECT_URL
# Local: both can point to the same local database
DATABASE_URL="postgresql://inovatic:your_password@localhost:5432/inovatic"
DIRECT_URL="postgresql://inovatic:your_password@localhost:5432/inovatic"

# Auth.js v5
AUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Cloudinary (article images + media)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Resend (transactional email)
# The sender address is NOT configurable — it is the city's own enrollment inbox
# (prijave@ / prijave.sibenik@udruga-inovatic.hr), picked per email in
# src/lib/email/client.ts. udruga-inovatic.hr must be a verified Resend domain.
RESEND_API_KEY="re_your_api_key_here"

# Umami analytics — public pages only; leave unset to disable tracking (e.g. local dev).
# Cloud: https://cloud.umami.is/script.js — self-hosted: https://<umami-host>/script.js
NEXT_PUBLIC_UMAMI_SCRIPT_URL=""
NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
# Comma-separated hostnames the tracker may run on (keeps localhost/previews silent)
NEXT_PUBLIC_UMAMI_DOMAINS="udruga-inovatic.hr,www.udruga-inovatic.hr"

# Release announcement (src/lib/release-announce.ts)
# On production start, any version in src/lib/releases.ts with no receipt row is
# mailed to every ADMIN, once. Needs no configuration — it is on whenever
# NODE_ENV=production and RESEND_API_KEY is set.
# Set this to any value ONLY to silence a production build run outside Railway
# (npm run build && npm start on a laptop reads real credentials).
# RELEASE_ANNOUNCE_DISABLED="1"

# Milliseconds between two outgoing emails in a bulk campaign or a release
# announcement. Defaults to 600 (Resend allows 2 requests/second).
# EMAIL_SEND_THROTTLE_MS="600"
