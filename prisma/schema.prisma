generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

// Tenant key: Split and Šibenik operate as fully separated organizations.
// Deliberately no @default — every create must stamp city explicitly, so a
// forgotten tenant assignment is a compile error, never a silent SPLIT row.
enum City {
  SPLIT
  SIBENIK
}

/// Rung on the standard SLR ladder. `UVOD` sits *before* SLR 1 rather than on
/// the ladder: it is the WeDo 2.0 program predškolci do the year before SLR 1,
/// split out of SLR 1 on 2026-07-29. The four SLR levels are deliberately not
/// renumbered — each one's name is its level.
enum CourseLevel {
  UVOD
  SLR_1
  SLR_2
  SLR_3
  SLR_4
}

/// What kind of program a Course is — the discriminator every behavioural
/// branch switches on. Supersedes the older `isCustom` boolean, which could
/// only say "radionica or not" and so silently lumped the competitive track in
/// with the SLR curriculum. Every arm differs in how it is scheduled, what a
/// student sees, and how it is paid for:
///
///   STANDARD    4 dated modules (ModuleSchedule), kids see the ACTIVE module
///               only, paid per module or per year.
///   RADIONICA   no modules, one closed [dateStart, dateEnd] range on the
///               group, flat material list, a single payment.
///   COMPETITION undated "modules" (the natjecanja), all visible at once, one
///               weekly session across a CourseSeason, paid monthly.
enum ProgramKind {
  STANDARD
  RADIONICA
  COMPETITION
}

enum InquiryStatus {
  NEW
  ACCOUNT_CREATED
  DECLINED
  PARTY_SCHEDULED
}

enum InquiryType {
  COURSE
  PARTY
}

enum SkillLevel {
  POCETNO
  U_RAZVOJU
  OSTVARENO
}

/// What a report card recommends the child does next. `COURSE` points at a real
/// Course row (`recommendedCourseId`); every other value is a track that has no
/// single course to name — the competitive program's teams are picked per
/// natjecanje, so a mentor recommends the team, not a catalog entry.
enum RecommendationKind {
  COURSE
  COMPETITION_PREP
  COMPETITION_PROGRAM
  COMPETITION_FLL
  COMPETITION_WRO
}

enum MaterialType {
  DOCUMENT
  PRESENTATION
  VIDEO
  LINK
  ROBOCAMP
}

enum MaterialScope {
  MODULE
  COURSE
  GROUP
}

enum EmailCampaignKind {
  CUSTOM
  REENROLLMENT
  /// One report card per e-mail. Unlike the other two kinds, an EVALUATION
  /// recipient row is ONE CHILD rather than one parent inbox: two siblings on
  /// the same address get two separate mails, each carrying exactly one card.
  /// That makes "someone else's evaluation in my inbox" structurally
  /// impossible instead of merely checked.
  EVALUATION
}

enum EmailRecipientStatus {
  /// Written upfront for every intended recipient, so the detail view lists the
  /// whole cohort from the first second and an interrupted campaign knows
  /// exactly who is left to mail.
  PENDING
  SENT
  FAILED
  /// The parent was already invited to this program for this year, so this send
  /// deliberately skipped them.
  ALREADY_SENT
  /// The child could not be mailed at all — the parent has no usable address,
  /// or (EVALUATION) the child has no filled-in report card to send.
  /// Persisted as a row (not just a count) so the admin can see WHICH child
  /// was missed and fix the record.
  SKIPPED
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  dateOfBirth   String?
  role          UserRole
  city          City
  username      String?   @unique
  plainPassword String?
  parentName    String?
  parentEmail   String?
  parentPhone   String?
  childSchool   String?
  gdprConsentAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  teacherAssignments   TeacherAssignment[]
  enrollments          Enrollment[]
  articles             Article[]
  materials            Material[]
  galleryImages        GalleryImage[]
  createdFromInquiries Inquiry[]           @relation("CreatedStudent")
  authoredComments     StudentComment[]    @relation("CommentAuthor")
  studentComments      StudentComment[]    @relation("CommentStudent")
  studentAssessments   StudentAssessment[] @relation("AssessmentStudent")
  authoredAssessments  StudentAssessment[] @relation("AssessmentAuthor")
  recordedAttendances  Attendance[]        @relation("AttendanceRecorder")
  teacherAttendances   TeacherAttendance[] @relation("TeacherAttendanceTeacher")
  recordedTeacherAttendances TeacherAttendance[] @relation("TeacherAttendanceRecorder")
  createdHolidays      SchoolYearHoliday[] @relation("HolidayCreator")
  sentEmailCampaigns   EmailCampaign[]     @relation("EmailCampaignSender")

  @@index([role, city])
}

model Course {
  id          String       @id @default(cuid())
  slug        String       @unique
  level       CourseLevel?
  title       String
  subtitle    String?
  description String       @db.Text
  ageMin      Int
  ageMax      Int
  equipment   String?
  price       Float?
  imageUrl    String?
  sortOrder   Int          @default(0)
  // The authoritative program-kind discriminator — branch on this, not on
  // `isCustom`.
  kind        ProgramKind  @default(STANDARD)
  // Legacy mirror of `kind == RADIONICA`, kept in sync on write. No
  // application code reads it; retained because the column is live in
  // production and dropping it would make a rollback lossy.
  isCustom    Boolean      @default(false)
  // Set on custom radionice (year-scoped); null on standard SLR (global).
  schoolYear  String?
  // null = shared standard SLR program (same catalog in every city);
  // set = per-city radionica (isCustom rows are venue-bound).
  city        City?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  modules           CourseModule[]
  scheduledGroups   ScheduledGroup[]
  inquiries         Inquiry[]
  materials         Material[]
  enrollmentWindows CourseEnrollmentWindow[]
  seasons           CourseSeason[]

  recommendedInAssessments StudentAssessment[]
  emailCampaignsAsTarget   EmailCampaign[]     @relation("EmailCampaignTarget")
}

// Per-school-year public signup window for a program. Keyed by
// (courseId, schoolYear) so every group of that program/year inherits the
// same window. A program is publicly enrollable only when this row exists
// with both dates set and now is inside [enrollmentStart, enrollmentEnd].
model CourseEnrollmentWindow {
  id              String    @id @default(cuid())
  courseId        String
  schoolYear      String
  // Each city opens/closes upisi for the same shared course independently.
  city            City
  enrollmentStart DateTime?
  enrollmentEnd   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, schoolYear, city])
  @@index([schoolYear])
}

/// How long a COMPETITION program runs in one school year. Standard programs
/// are paced by their four ModuleSchedule windows; the competitive track has no
/// dated modules, so its groups derive sessions from this single range instead:
/// one session per week on the group's `dayOfWeek` inside [startDate, endDate],
/// with a week dropped outright when a holiday lands on it. There is
/// deliberately no session-count target — two groups on different weekdays may
/// legitimately finish the year with different totals.
///
/// Per city, like ModuleSchedule and CourseEnrollmentWindow: Split and Šibenik
/// run the same program on their own dates.
model CourseSeason {
  id         String    @id @default(cuid())
  courseId   String
  schoolYear String
  city       City
  startDate  DateTime? @db.Date
  endDate    DateTime? @db.Date
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, schoolYear, city])
  @@index([schoolYear])
}

model CourseModule {
  id          String  @id @default(cuid())
  courseId    String
  title       String
  description String? @db.Text
  sortOrder   Int     @default(0)

  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  schedules     ModuleSchedule[]
  materials     Material[]
  galleryImages GalleryImage[]
}

model ModuleSchedule {
  id         String    @id @default(cuid())
  moduleId   String
  schoolYear String
  // Each city runs its own planner for the shared curriculum (Šibenik can
  // start mid-cycle with its own module dates).
  city       City
  startDate  DateTime? @db.Date
  endDate    DateTime? @db.Date
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  module            CourseModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleEnrollments ModuleEnrollment[]

  @@unique([moduleId, schoolYear, city])
}

// Registry of school years so a year can exist as a blank slate
// with zero groups/schedules. Label format: "YYYY/YYYY".
model SchoolYear {
  label     String   @id
  createdAt DateTime @default(now())

  holidays SchoolYearHoliday[]
}

// Per-school-year days when no workshops happen — public holidays, school
// breaks, ad-hoc closures. Excluded from `computeExpectedSessions`, so
// attendance never shows a slot for them.
model SchoolYearHoliday {
  id          String   @id @default(cuid())
  schoolYear  String
  date        DateTime @db.Date
  name        String?
  // Per-city holiday calendars; national holidays are duplicated per city
  // (accepted duplication — keeps attendance pacing queries flat).
  city        City
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolYearRef SchoolYear @relation(fields: [schoolYear], references: [label], onDelete: Cascade)
  createdBy     User?      @relation("HolidayCreator", fields: [createdById], references: [id])

  @@unique([schoolYear, city, date])
  @@index([schoolYear])
}

model Location {
  id      String  @id @default(cuid())
  name    String
  address String
  phone   String?
  email   String?
  city    City

  scheduledGroups ScheduledGroup[]

  // Composite-FK target so ScheduledGroup(locationId, city) can reference
  // (id, city) — DB-level guarantee that a group's city matches its venue's.
  @@unique([id, city])
  @@index([city])
}

model ScheduledGroup {
  id          String   @id @default(cuid())
  courseId    String
  locationId  String
  // Denormalized from the venue (stamped server-side at create; cross-city
  // location moves are rejected). The composite FK below makes drift from
  // Location.city impossible at the DB level.
  city        City
  name        String?
  // For radionice (Course.isCustom = true): closed YYYY-MM-DD range — the group runs every day in
  // [dateStart, dateEnd] at the same startTime/endTime. For standard programs both are null and
  // `dayOfWeek` is used instead.
  dateStart   String?
  dateEnd     String?
  dayOfWeek   String?
  startTime   String?
  endTime     String?
  schoolYear  String
  maxStudents Int      @default(12)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course             Course              @relation(fields: [courseId], references: [id])
  location           Location            @relation(fields: [locationId, city], references: [id, city])
  teacherAssignments TeacherAssignment[]
  teacherAttendances TeacherAttendance[]
  enrollments        Enrollment[]
  materials          Material[]
  materialHides      MaterialGroupHide[]
  galleryImages      GalleryImage[]
  assignedInquiries  Inquiry[]           @relation("AssignedGroup")
  preferredInquiries Inquiry[]           @relation("PreferredGroup")
  studentComments    StudentComment[]
  studentAssessments StudentAssessment[]

  @@index([city, schoolYear])
}

model TeacherAssignment {
  id               String @id @default(cuid())
  userId           String
  scheduledGroupId String

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledGroup ScheduledGroup @relation(fields: [scheduledGroupId], references: [id], onDelete: Cascade)

  @@unique([userId, scheduledGroupId])
}

model Inquiry {
  id                 String        @id @default(cuid())
  type               InquiryType   @default(COURSE)
  // Required (not derivable): PARTY inquiries have no group→location chain.
  // COURSE inquiries persist the parent's mandatory city choice from /upisi.
  city               City
  parentName         String
  parentEmail        String
  parentPhone        String
  // Null for PARTY inquiries (no enrolling child); required for COURSE via the
  // public inquiry Zod schema.
  childFirstName     String?
  childLastName      String?
  childDateOfBirth   String?
  childSchool        String?
  childGrade         String?
  courseId           String?
  scheduledGroupId   String?
  // The parent's answer when none of the proposed termini work for them — the
  // second half of the "Željeni termin" dropdown, mutually exclusive with
  // scheduledGroupId. Offered on the competitive program's invitation link only
  // (its few weekly slots are negotiable), so it stays false everywhere else.
  noSuitableTermin   Boolean       @default(false)
  message            String?       @db.Text
  referralSource     String?
  // PARTY only: parent's optional preferred date from the public form.
  partyProposedDate  DateTime?     @db.Date
  // PARTY only: admin-agreed date + "HH:mm" start time, set when scheduling.
  partyConfirmedDate DateTime?     @db.Date
  partyStartTime     String?
  consentGivenAt     DateTime?
  status             InquiryStatus @default(NEW)
  schoolYear         String?
  declineReason      String?       @db.Text
  assignedGroupId    String?
  studentId          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  course         Course?         @relation(fields: [courseId], references: [id])
  scheduledGroup ScheduledGroup? @relation("PreferredGroup", fields: [scheduledGroupId], references: [id])
  assignedGroup  ScheduledGroup? @relation("AssignedGroup", fields: [assignedGroupId], references: [id])
  student        User?           @relation("CreatedStudent", fields: [studentId], references: [id])

  @@index([scheduledGroupId])
  @@index([status])
  @@index([assignedGroupId])
  @@index([courseId])
  @@index([studentId])
  @@index([schoolYear])
  @@index([type, status])
  @@index([city, schoolYear, status])
}

model Enrollment {
  id               String    @id @default(cuid())
  userId           String
  scheduledGroupId String
  schoolYear       String
  // Admin "whole school year paid" mark. Covers every module of this
  // enrollment including ones added later; for radionice (course.isCustom,
  // no modules) it doubles as the single paid mark. Null = not paid.
  fullYearPaidAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledGroup    ScheduledGroup     @relation(fields: [scheduledGroupId], references: [id])
  moduleEnrollments ModuleEnrollment[]
  enrollmentMonths  EnrollmentMonth[]
  attendances       Attendance[]

  @@unique([userId, scheduledGroupId, schoolYear])
}

/// One payable month of a monthly-fee enrollment (COMPETITION programs). Rows
/// are written up front for the rest of the season the same way ModuleEnrollment
/// rows are, so "not paid yet" is a stored fact rather than something derived at
/// read time — and the 1st-of-the-month flip needs no scheduled job: a month
/// starts counting as owed the moment `periodStart <= now`.
///
/// A child enrolling mid-season is only charged from their own join month; the
/// months before it are never created.
model EnrollmentMonth {
  id           String    @id @default(cuid())
  enrollmentId String
  /// First day of the billed calendar month (YYYY-MM-01).
  periodStart  DateTime  @db.Date
  /// Null = owed (once periodStart has passed). Set = paid.
  paidAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, periodStart])
  @@index([periodStart])
}

model ModuleEnrollment {
  id               String    @id @default(cuid())
  enrollmentId     String
  moduleScheduleId String
  // Admin per-module paid mark. Null = unpaid (or covered by the parent
  // enrollment's fullYearPaidAt).
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  enrollment     Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  moduleSchedule ModuleSchedule @relation(fields: [moduleScheduleId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, moduleScheduleId])
}

model Material {
  id               String        @id @default(cuid())
  scope            MaterialScope
  scheduledGroupId String?
  courseId         String?
  moduleId         String?
  title            String
  description      String?       @db.Text
  type             MaterialType
  fileUrl          String?
  externalUrl      String?
  fileSize         Int?
  mimeType         String?
  sortOrder        Int           @default(0)
  uploadedById     String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  scheduledGroup ScheduledGroup?     @relation(fields: [scheduledGroupId], references: [id], onDelete: Restrict)
  course         Course?             @relation(fields: [courseId], references: [id], onDelete: Restrict)
  module         CourseModule?       @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  uploadedBy     User                @relation(fields: [uploadedById], references: [id])
  hiddenInGroups MaterialGroupHide[]

  @@index([scope, moduleId])
  @@index([scope, courseId])
  @@index([scope, scheduledGroupId])
}

model MaterialGroupHide {
  id               String   @id @default(cuid())
  materialId       String
  scheduledGroupId String
  createdAt        DateTime @default(now())

  material       Material       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  scheduledGroup ScheduledGroup @relation(fields: [scheduledGroupId], references: [id], onDelete: Cascade)

  @@unique([materialId, scheduledGroupId])
}

model GalleryImage {
  id               String   @id @default(cuid())
  scheduledGroupId String
  moduleId         String?
  url              String
  publicId         String
  width            Int?
  height           Int?
  caption          String?
  sortOrder        Int      @default(0)
  uploadedById     String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  scheduledGroup ScheduledGroup @relation(fields: [scheduledGroupId], references: [id], onDelete: Cascade)
  module         CourseModule?  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  uploadedBy     User           @relation(fields: [uploadedById], references: [id])

  @@index([scheduledGroupId, moduleId, sortOrder])
}

model Attendance {
  id           String   @id @default(cuid())
  enrollmentId String
  sessionDate  DateTime @db.Date
  present      Boolean
  note         String?  @db.Text
  recordedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  recordedBy User       @relation("AttendanceRecorder", fields: [recordedById], references: [id])

  @@unique([enrollmentId, sessionDate])
  @@index([sessionDate])
}

/// Teaching hours, marked alongside student attendance. Deliberately keyed on
/// (user, group, date) and NOT on TeacherAssignment: unassigning a teacher — or
/// a stand-in covering one session — must never rewrite who worked which hour.
/// The admin payout report reads these rows and nothing else.
model TeacherAttendance {
  id               String   @id @default(cuid())
  userId           String
  scheduledGroupId String
  sessionDate      DateTime @db.Date
  present          Boolean
  recordedById     String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User           @relation("TeacherAttendanceTeacher", fields: [userId], references: [id], onDelete: Cascade)
  // RESTRICT, not Cascade: these rows are the sole basis for hourly payout, so
  // deleting a group must never silently erase what a teacher already worked.
  // `deleteGroup`/`deleteCourse` block on them explicitly; this is the backstop
  // for any future path that forgets to.
  scheduledGroup ScheduledGroup @relation(fields: [scheduledGroupId], references: [id], onDelete: Restrict)
  recordedBy     User           @relation("TeacherAttendanceRecorder", fields: [recordedById], references: [id])

  @@unique([userId, scheduledGroupId, sessionDate])
  @@index([userId, sessionDate])
  @@index([scheduledGroupId, sessionDate])
  // recordedById is ON DELETE RESTRICT — without this the FK check seq-scans
  // the fastest-growing table in the schema on every User delete.
  @@index([recordedById])
}

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?   @db.Text
  content     Json      @default("[]")
  coverImage  String?
  authorId    String
  // Auto-stamped from the authoring admin's city; public novosti list shows
  // all cities with a per-article badge, admin CRUD is city-scoped.
  city        City
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User           @relation(fields: [authorId], references: [id])
  tags   ArticleTag[]
  images ArticleImage[]

  @@index([city, isPublished])
}

model ArticleImage {
  id        String  @id @default(cuid())
  articleId String
  url       String
  caption   String?
  sortOrder Int     @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  articles ArticleTag[]
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id])

  @@id([articleId, tagId])
}

model StudentComment {
  id        String   @id @default(cuid())
  studentId String
  groupId   String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User           @relation("CommentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  group   ScheduledGroup @relation(fields: [groupId], references: [id])
  author  User           @relation("CommentAuthor", fields: [authorId], references: [id])
}

model StudentAssessment {
  id        String @id @default(cuid())
  studentId String
  groupId   String
  authorId  String

  // PRAKTIČNE VJEŠTINE — the rubric differs by program kind, so each skill has
  // its own column rather than three reused slots: a query for `slaganje` must
  // always mean slaganje, never "whatever the practical slot held for this
  // group's kind". Only the columns belonging to the group's kind are ever
  // written (enforced in `upsertStudentAssessment`); the rest stay null.
  //   STANDARD    slaganje, programiranje, inovacije
  //   COMPETITION razradaIdeja, izvedivost, inovacije
  slaganje      SkillLevel?
  programiranje SkillLevel?
  razradaIdeja  SkillLevel?
  izvedivost    SkillLevel?
  inovacije     SkillLevel?

  // TIMSKE VJEŠTINE
  suradnja     SkillLevel?
  komunikacija SkillLevel?
  zabava       SkillLevel?

  opisnaOcjena        String?             @db.Text
  recommendationKind  RecommendationKind?
  recommendedCourseId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student           User           @relation("AssessmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  group             ScheduledGroup @relation(fields: [groupId], references: [id])
  author            User           @relation("AssessmentAuthor", fields: [authorId], references: [id])
  recommendedCourse Course?        @relation(fields: [recommendedCourseId], references: [id], onDelete: SetNull)

  @@unique([studentId, groupId])
  @@index([groupId])
}

// One row per admin bulk-email send from /admin/email. Recipient rows double as
// the REENROLLMENT idempotency ledger: a parent with a SENT row for the same
// (city, kind, targetCourseId, targetSchoolYear) is skipped on re-runs, so a
// double-click or a browser close mid-loop never double-mails an invitation.
// CUSTOM campaigns are deliberately repeatable (no skip).
model EmailCampaign {
  id               String            @id @default(cuid())
  city             City
  kind             EmailCampaignKind
  sourceSchoolYear String
  // Audit-only snapshot of the selected cohort groups (no FK — groups may be
  // deleted later; the send resolved recipients at send time anyway). Empty
  // when the cohort was selected by preporuka instead.
  sourceGroupIds   String[]
  // Preporuka-mode cohort: display labels of the selected preporuka filters
  // (per-course titles + special tracks; year-wide, group-independent).
  // Labels rather than ids so history stays readable after course deletion.
  // Empty in group mode.
  sourceRecommendations String[] @default([])
  targetSchoolYear String?
  targetCourseId   String?
  /// The termini offered in an invitation. Audit-only (no FK — groups may be
  /// deleted), but also what lets a resumed send rebuild the same schedule
  /// boxes the first run used.
  targetGroupIds   String[] @default([])
  subject          String
  bodyText         String            @db.Text
  sentById         String
  // Incremented per recipient while the send runs, so progress polling and an
  // interrupted campaign both read accurate numbers. Recipient rows remain the
  // ground truth.
  sentCount        Int               @default(0)
  failedCount      Int               @default(0)
  skippedCount     Int               @default(0)
  excludedCount    Int               @default(0)
  /// How many parents this send set out to mail — the denominator for progress.
  totalCount       Int               @default(0)
  /// Null while the send is still running. A campaign left unfinished by a
  /// deploy or crash can be resumed; already-sent parents are skipped by the
  /// (sentKey, parentEmail) unique index.
  finishedAt       DateTime?
  createdAt        DateTime          @default(now())

  targetCourse Course? @relation("EmailCampaignTarget", fields: [targetCourseId], references: [id], onDelete: SetNull)
  sentBy       User    @relation("EmailCampaignSender", fields: [sentById], references: [id])

  recipients EmailCampaignRecipient[]

  @@index([city, createdAt])
  @@index([city, kind, targetCourseId, targetSchoolYear])
  // The composite above leads with `city`, so it cannot serve either FK check:
  // sentById is RESTRICT, targetCourseId is SET NULL on course delete.
  @@index([sentById])
  @@index([targetCourseId])
}

model EmailCampaignRecipient {
  id          String               @id @default(cuid())
  campaignId  String
  parentEmail String
  status      EmailRecipientStatus
  sentAt      DateTime             @default(now())
  /// Makes "one invitation per parent per program per year" a database rule
  /// rather than a hope. Set to `city:kind:targetCourseId:targetSchoolYear`
  /// **only** on a SENT REENROLLMENT row; null for CUSTOM (deliberately
  /// repeatable) and for FAILED rows (so a retry may invite again). Postgres
  /// treats NULLs as distinct, so those rows never collide with each other.
  sentKey String?
  /// Snapshot of the children this address was mailed for, taken at send time
  /// so the detail view survives later renames, transfers or deletions.
  childNames String[] @default([])
  /// EVALUATION only: the exact report card(s) this row is mailed — normally a
  /// single one, since an EVALUATION row is one child. Stored on the ROW rather
  /// than on the campaign so per-recipient content can never be shared, and
  /// re-verified against the student's current parentEmail immediately before
  /// each send (`assertCardsBelongTo`), so a card cannot reach another inbox
  /// even if cohort resolution were wrong. Empty for CUSTOM/REENROLLMENT.
  assessmentIds String[] @default([])
  /// Why a FAILED send failed, or why a SKIPPED child had no usable address.
  failureReason String?

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([sentKey, parentEmail])
  @@index([campaignId])
}
