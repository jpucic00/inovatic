generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
}

// Tenant key: Split and Šibenik operate as fully separated organizations.
// Deliberately no @default — every create must stamp city explicitly, so a
// forgotten tenant assignment is a compile error, never a silent SPLIT row.
enum City {
  SPLIT
  SIBENIK
}

enum CourseLevel {
  SLR_1
  SLR_2
  SLR_3
  SLR_4
}

enum InquiryStatus {
  NEW
  ACCOUNT_CREATED
  DECLINED
  PARTY_SCHEDULED
}

enum InquiryType {
  COURSE
  PARTY
}

enum SkillLevel {
  POCETNO
  U_RAZVOJU
  OSTVARENO
}

enum RecommendationKind {
  COURSE
  COMPETITION_PREP
  COMPETITION_PROGRAM
}

enum MaterialType {
  DOCUMENT
  PRESENTATION
  VIDEO
  LINK
  ROBOCAMP
}

enum MaterialScope {
  MODULE
  COURSE
  GROUP
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  dateOfBirth   String?
  role          UserRole
  city          City
  username      String?   @unique
  plainPassword String?
  parentName    String?
  parentEmail   String?
  parentPhone   String?
  childSchool   String?
  gdprConsentAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  teacherAssignments   TeacherAssignment[]
  enrollments          Enrollment[]
  articles             Article[]
  materials            Material[]
  galleryImages        GalleryImage[]
  createdFromInquiries Inquiry[]           @relation("CreatedStudent")
  authoredComments     StudentComment[]    @relation("CommentAuthor")
  studentComments      StudentComment[]    @relation("CommentStudent")
  studentAssessments   StudentAssessment[] @relation("AssessmentStudent")
  authoredAssessments  StudentAssessment[] @relation("AssessmentAuthor")
  recordedAttendances  Attendance[]        @relation("AttendanceRecorder")
  createdHolidays      SchoolYearHoliday[] @relation("HolidayCreator")

  @@index([role, city])
}

model Course {
  id          String       @id @default(cuid())
  slug        String       @unique
  level       CourseLevel?
  title       String
  subtitle    String?
  description String       @db.Text
  ageMin      Int
  ageMax      Int
  equipment   String?
  price       Float?
  imageUrl    String?
  sortOrder   Int          @default(0)
  isCustom    Boolean      @default(false)
  // Set on custom radionice (year-scoped); null on standard SLR (global).
  schoolYear  String?
  // null = shared standard SLR program (same catalog in every city);
  // set = per-city radionica (isCustom rows are venue-bound).
  city        City?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  modules           CourseModule[]
  scheduledGroups   ScheduledGroup[]
  inquiries         Inquiry[]
  materials         Material[]
  enrollmentWindows CourseEnrollmentWindow[]

  recommendedInAssessments StudentAssessment[]
}

// Per-school-year public signup window for a program. Keyed by
// (courseId, schoolYear) so every group of that program/year inherits the
// same window. A program is publicly enrollable only when this row exists
// with both dates set and now is inside [enrollmentStart, enrollmentEnd].
model CourseEnrollmentWindow {
  id              String    @id @default(cuid())
  courseId        String
  schoolYear      String
  // Each city opens/closes upisi for the same shared course independently.
  city            City
  enrollmentStart DateTime?
  enrollmentEnd   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, schoolYear, city])
  @@index([schoolYear])
}

model CourseModule {
  id          String  @id @default(cuid())
  courseId    String
  title       String
  description String? @db.Text
  sortOrder   Int     @default(0)

  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  schedules     ModuleSchedule[]
  materials     Material[]
  galleryImages GalleryImage[]
}

model ModuleSchedule {
  id         String    @id @default(cuid())
  moduleId   String
  schoolYear String
  // Each city runs its own planner for the shared curriculum (Šibenik can
  // start mid-cycle with its own module dates).
  city       City
  startDate  DateTime? @db.Date
  endDate    DateTime? @db.Date
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  module            CourseModule       @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleEnrollments ModuleEnrollment[]

  @@unique([moduleId, schoolYear, city])
}

// Registry of school years so a year can exist as a blank slate
// with zero groups/schedules. Label format: "YYYY/YYYY".
model SchoolYear {
  label     String   @id
  createdAt DateTime @default(now())

  holidays SchoolYearHoliday[]
}

// Per-school-year days when no workshops happen — public holidays, school
// breaks, ad-hoc closures. Excluded from `computeExpectedSessions`, so
// attendance never shows a slot for them.
model SchoolYearHoliday {
  id          String   @id @default(cuid())
  schoolYear  String
  date        DateTime @db.Date
  name        String?
  // Per-city holiday calendars; national holidays are duplicated per city
  // (accepted duplication — keeps attendance pacing queries flat).
  city        City
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schoolYearRef SchoolYear @relation(fields: [schoolYear], references: [label], onDelete: Cascade)
  createdBy     User?      @relation("HolidayCreator", fields: [createdById], references: [id])

  @@unique([schoolYear, city, date])
  @@index([schoolYear])
}

model Location {
  id      String  @id @default(cuid())
  name    String
  address String
  phone   String?
  email   String?
  city    City

  scheduledGroups ScheduledGroup[]

  // Composite-FK target so ScheduledGroup(locationId, city) can reference
  // (id, city) — DB-level guarantee that a group's city matches its venue's.
  @@unique([id, city])
  @@index([city])
}

model ScheduledGroup {
  id          String   @id @default(cuid())
  courseId    String
  locationId  String
  // Denormalized from the venue (stamped server-side at create; cross-city
  // location moves are rejected). The composite FK below makes drift from
  // Location.city impossible at the DB level.
  city        City
  name        String?
  // For radionice (Course.isCustom = true): closed YYYY-MM-DD range — the group runs every day in
  // [dateStart, dateEnd] at the same startTime/endTime. For standard programs both are null and
  // `dayOfWeek` is used instead.
  dateStart   String?
  dateEnd     String?
  dayOfWeek   String?
  startTime   String?
  endTime     String?
  schoolYear  String
  maxStudents Int      @default(12)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course             Course              @relation(fields: [courseId], references: [id])
  location           Location            @relation(fields: [locationId, city], references: [id, city])
  teacherAssignments TeacherAssignment[]
  enrollments        Enrollment[]
  materials          Material[]
  materialHides      MaterialGroupHide[]
  galleryImages      GalleryImage[]
  assignedInquiries  Inquiry[]           @relation("AssignedGroup")
  preferredInquiries Inquiry[]           @relation("PreferredGroup")
  studentComments    StudentComment[]
  studentAssessments StudentAssessment[]

  @@index([city, schoolYear])
}

model TeacherAssignment {
  id               String @id @default(cuid())
  userId           String
  scheduledGroupId String

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledGroup ScheduledGroup @relation(fields: [scheduledGroupId], references: [id], onDelete: Cascade)

  @@unique([userId, scheduledGroupId])
}

model Inquiry {
  id                 String        @id @default(cuid())
  type               InquiryType   @default(COURSE)
  // Required (not derivable): PARTY inquiries have no group→location chain.
  // COURSE inquiries persist the parent's mandatory city choice from /upisi.
  city               City
  parentName         String
  parentEmail        String
  parentPhone        String
  // Null for PARTY inquiries (no enrolling child); required for COURSE via the
  // public inquiry Zod schema.
  childFirstName     String?
  childLastName      String?
  childDateOfBirth   String?
  childSchool        String?
  childGrade         String?
  courseId           String?
  scheduledGroupId   String?
  message            String?       @db.Text
  referralSource     String?
  // PARTY only: parent's optional preferred date from the public form.
  partyProposedDate  DateTime?     @db.Date
  // PARTY only: admin-agreed date + "HH:mm" start time, set when scheduling.
  partyConfirmedDate DateTime?     @db.Date
  partyStartTime     String?
  consentGivenAt     DateTime?
  status             InquiryStatus @default(NEW)
  schoolYear         String?
  declineReason      String?       @db.Text
  assignedGroupId    String?
  studentId          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  course         Course?         @relation(fields: [courseId], references: [id])
  scheduledGroup ScheduledGroup? @relation("PreferredGroup", fields: [scheduledGroupId], references: [id])
  assignedGroup  ScheduledGroup? @relation("AssignedGroup", fields: [assignedGroupId], references: [id])
  student        User?           @relation("CreatedStudent", fields: [studentId], references: [id])

  @@index([scheduledGroupId])
  @@index([status])
  @@index([assignedGroupId])
  @@index([courseId])
  @@index([studentId])
  @@index([schoolYear])
  @@index([type, status])
  @@index([city, schoolYear, status])
}

model Enrollment {
  id               String    @id @default(cuid())
  userId           String
  scheduledGroupId String
  schoolYear       String
  // Admin "whole school year paid" mark. Covers every module of this
  // enrollment including ones added later; for radionice (course.isCustom,
  // no modules) it doubles as the single paid mark. Null = not paid.
  fullYearPaidAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scheduledGroup    ScheduledGroup     @relation(fields: [scheduledGroupId], references: [id])
  moduleEnrollments ModuleEnrollment[]
  attendances       Attendance[]

  @@unique([userId, scheduledGroupId, schoolYear])
}

model ModuleEnrollment {
  id               String    @id @default(cuid())
  enrollmentId     String
  moduleScheduleId String
  // Admin per-module paid mark. Null = unpaid (or covered by the parent
  // enrollment's fullYearPaidAt).
  paidAt           DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  enrollment     Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  moduleSchedule ModuleSchedule @relation(fields: [moduleScheduleId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, moduleScheduleId])
}

model Material {
  id               String        @id @default(cuid())
  scope            MaterialScope
  scheduledGroupId String?
  courseId         String?
  moduleId         String?
  title            String
  description      String?       @db.Text
  type             MaterialType
  fileUrl          String?
  externalUrl      String?
  fileSize         Int?
  mimeType         String?
  sortOrder        Int           @default(0)
  uploadedById     String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  scheduledGroup ScheduledGroup?     @relation(fields: [scheduledGroupId], references: [id], onDelete: Restrict)
  course         Course?             @relation(fields: [courseId], references: [id], onDelete: Restrict)
  module         CourseModule?       @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  uploadedBy     User                @relation(fields: [uploadedById], references: [id])
  hiddenInGroups MaterialGroupHide[]

  @@index([scope, moduleId])
  @@index([scope, courseId])
  @@index([scope, scheduledGroupId])
}

model MaterialGroupHide {
  id               String   @id @default(cuid())
  materialId       String
  scheduledGroupId String
  createdAt        DateTime @default(now())

  material       Material       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  scheduledGroup ScheduledGroup @relation(fields: [scheduledGroupId], references: [id], onDelete: Cascade)

  @@unique([materialId, scheduledGroupId])
}

model GalleryImage {
  id               String   @id @default(cuid())
  scheduledGroupId String
  moduleId         String?
  url              String
  publicId         String
  width            Int?
  height           Int?
  caption          String?
  sortOrder        Int      @default(0)
  uploadedById     String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  scheduledGroup ScheduledGroup @relation(fields: [scheduledGroupId], references: [id], onDelete: Cascade)
  module         CourseModule?  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  uploadedBy     User           @relation(fields: [uploadedById], references: [id])

  @@index([scheduledGroupId, moduleId, sortOrder])
}

model Attendance {
  id           String   @id @default(cuid())
  enrollmentId String
  sessionDate  DateTime @db.Date
  present      Boolean
  note         String?  @db.Text
  recordedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  recordedBy User       @relation("AttendanceRecorder", fields: [recordedById], references: [id])

  @@unique([enrollmentId, sessionDate])
  @@index([sessionDate])
}

model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?   @db.Text
  content     Json      @default("[]")
  coverImage  String?
  authorId    String
  // Auto-stamped from the authoring admin's city; public novosti list shows
  // all cities with a per-article badge, admin CRUD is city-scoped.
  city        City
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User           @relation(fields: [authorId], references: [id])
  tags   ArticleTag[]
  images ArticleImage[]

  @@index([city, isPublished])
}

model ArticleImage {
  id        String  @id @default(cuid())
  articleId String
  url       String
  caption   String?
  sortOrder Int     @default(0)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  articles ArticleTag[]
}

model ArticleTag {
  articleId String
  tagId     String

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id])

  @@id([articleId, tagId])
}

model StudentComment {
  id        String   @id @default(cuid())
  studentId String
  groupId   String
  authorId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User           @relation("CommentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  group   ScheduledGroup @relation(fields: [groupId], references: [id])
  author  User           @relation("CommentAuthor", fields: [authorId], references: [id])
}

model StudentAssessment {
  id        String @id @default(cuid())
  studentId String
  groupId   String
  authorId  String

  // PRAKTIČNE VJEŠTINE
  slaganje      SkillLevel?
  programiranje SkillLevel?
  inovacije     SkillLevel?

  // TIMSKE VJEŠTINE
  suradnja     SkillLevel?
  komunikacija SkillLevel?
  zabava       SkillLevel?

  opisnaOcjena        String?             @db.Text
  recommendationKind  RecommendationKind?
  recommendedCourseId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student           User           @relation("AssessmentStudent", fields: [studentId], references: [id], onDelete: Cascade)
  group             ScheduledGroup @relation(fields: [groupId], references: [id])
  author            User           @relation("AssessmentAuthor", fields: [authorId], references: [id])
  recommendedCourse Course?        @relation(fields: [recommendedCourseId], references: [id], onDelete: SetNull)

  @@unique([studentId, groupId])
  @@index([groupId])
}
