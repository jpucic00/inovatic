{
  "name": "inovatic",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "email": "email dev --dir emails --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --dir src",
    "lint:ts": "tsc --noEmit",
    "lint:dead": "knip",
    "lint:all": "npm run lint && npm run lint:ts && npm run lint:dead && npm run test:unit",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:unit:ui": "vitest --ui --project unit",
    "test:integration:reset": "bash scripts/reset-test-db.sh",
    "test:integration": "npm run test:integration:reset && DATABASE_URL=postgresql://inovatic:inovatic_dev_2024@localhost:5432/inovatic_test DIRECT_URL=postgresql://inovatic:inovatic_dev_2024@localhost:5432/inovatic_test vitest run --project integration",
    "test:integration:watch": "DATABASE_URL=postgresql://inovatic:inovatic_dev_2024@localhost:5432/inovatic_test DIRECT_URL=postgresql://inovatic:inovatic_dev_2024@localhost:5432/inovatic_test vitest --project integration",
    "sonar:start": "docker compose -f docker-compose.sonar.yml up -d",
    "sonar:stop": "docker compose -f docker-compose.sonar.yml down",
    "sonar:scan": "sonar-scanner -Dsonar.host.url=http://localhost:9000 -Dsonar.token=$SONAR_TOKEN",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:articles": "tsx prisma/seed-articles.ts",
    "db:seed:competition": "tsx prisma/seed-competition-program.ts",
    "db:seed:programs": "tsx prisma/seed-programs.ts",
    "db:seed:previous-year": "tsx prisma/seed-previous-year.ts",
    "db:refresh-dev-dates": "tsx scripts/refresh-dev-dates.ts",
    "db:import-history": "tsx scripts/import-history.ts",
    "db:watermark-images": "tsx scripts/watermark-existing-urls.ts",
    "db:import-competition": "tsx scripts/import-competition.ts",
    "download-wp-images": "tsx scripts/download-wp-images.ts",
    "migrate-images": "tsx scripts/migrate-images-to-cloudinary.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@blocknote/core": "^0.47.1",
    "@blocknote/mantine": "^0.47.1",
    "@blocknote/react": "^0.47.1",
    "@hookform/resolvers": "^5.2.2",
    "@mantine/core": "^8.3.17",
    "@mantine/hooks": "^8.3.17",
    "@prisma/client": "^6.5.0",
    "@react-email/components": "^0.0.30",
    "@tailwindcss/typography": "^0.5.19",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "next-auth": "^5.0.0-beta.25",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.71.2",
    "resend": "^4.0.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "yet-another-react-lightbox": "^3.29.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "^1.58.2",
    "@react-email/ui": "^6.9.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/ui": "^4.1.6",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.13",
    "exceljs": "^4.4.0",
    "jsdom": "^29.1.1",
    "knip": "^5.88.0",
    "postcss": "^8.5.0",
    "prisma": "^6.5.0",
    "react-email": "^6.9.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "vitest": "^4.1.6"
  }
}
